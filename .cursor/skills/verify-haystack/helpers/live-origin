#!/usr/bin/env bash
# Production ship gate. Isolated helpers/http is not this.
# Default origins: https://longmuch.com and https://longmuch-api.onrender.com
# Override with LIVE_WEB and LIVE_API. LIVE_WWW (default https://www.longmuch.com)
# must permanently redirect (301/308) to $LIVE_WEB keeping path + query;
# set LIVE_WWW= (empty) to skip that check.
#
# Usage:
#   FEATURE=live-origin helpers/live-origin
#
# Pass when public HTML title matches layout metadata AND public /contract
# schema_version matches `uv run longmuch contract`. Isolated doctor green
# is not enough to call the product shipped.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

LIVE_WEB="${LIVE_WEB:-https://longmuch.com}"
LIVE_WWW="${LIVE_WWW-https://www.longmuch.com}"
LIVE_API="${LIVE_API:-https://longmuch-api.onrender.com}"
EXPECTED_TITLE="LongMuch - How much? How long?"

FEATURE="${FEATURE:-live-origin}"
EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
mkdir -p "$EVIDENCE"

http_code() {
  local out="$1" url="$2"
  local limit="${3:-25}"
  local code
  set +e
  code="$(curl -sS -o "$out" -w '%{http_code}' --max-time "$limit" "$url")"
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 || -z "$code" ]]; then
    echo "000"
  else
    echo "$code"
  fi
}

web_html="$EVIDENCE/home.html"
web_code="$(http_code "$web_html" "$LIVE_WEB/")"
echo "$web_code" > "$EVIDENCE/home.status"
title="$(html_title "$web_html")"
{
  echo "feature=$FEATURE"
  echo "url=$LIVE_WEB/"
  echo "http_status=$web_code"
  echo "title=$title"
  echo "create_next_app_count=$(html_count "$web_html" 'Create Next App')"
  echo "longmuch_title_count=$(html_count "$web_html" "$EXPECTED_TITLE")"
} > "$EVIDENCE/home.meta.txt"
echo "GET $LIVE_WEB/ -> HTTP $web_code title=$title"
[[ "$web_code" == "200" ]] || die "live web GET not 200 (got $web_code)"
[[ "$title" == "$EXPECTED_TITLE" ]] || die "live title is not $EXPECTED_TITLE (got $title). Isolated prove is not production."
if grep -q 'Create Next App' "$web_html"; then
  die "live HTML still contains Create Next App"
fi

# www -> apex permanent redirect (Vercel project domain redirect, 308).
if [[ -n "$LIVE_WWW" ]]; then
  for path in "/" "/AAPL?x=1"; do
    set +e
    hdr="$(curl -sS -o /dev/null -D - --max-time 25 "$LIVE_WWW$path")"
    set -e
    code="$(printf '%s' "$hdr" | awk 'toupper($1) ~ /^HTTP/ {c=$2} END {print c}')"
    loc="$(printf '%s' "$hdr" | awk 'tolower($1)=="location:" {print $2}' | tr -d '\r' | tail -1)"
    echo "GET $LIVE_WWW$path -> HTTP $code location=$loc" | tee -a "$EVIDENCE/www-redirect.txt"
    [[ "$code" == "301" || "$code" == "308" ]] || die "www not a permanent redirect (got $code for $LIVE_WWW$path)"
    [[ "$loc" == "$LIVE_WEB$path" ]] || die "www redirect location $loc != $LIVE_WEB$path"
  done
fi

contract_body="$EVIDENCE/contract.json"
# Render free sleeps. Cold /contract often exceeds 25s.
api_code="$(http_code "$contract_body" "$LIVE_API/contract" 90)"
if [[ "$api_code" != "200" ]]; then
  api_code="$(http_code "$contract_body" "$LIVE_API/contract" 90)"
fi
echo "$api_code" > "$EVIDENCE/contract.status"
echo "GET $LIVE_API/contract -> HTTP $api_code"
[[ "$api_code" == "200" ]] || die "live API /contract not 200 (got $api_code). Frontend 200 is not enough. Render may still be asleep."
grep -q 'schema_version' "$contract_body" || die "live /contract missing schema_version"

local_contract="$(cd "$REPO_ROOT" && uv run longmuch contract 2>/dev/null)" || die "uv run longmuch contract failed"
python3 - "$contract_body" "$local_contract" <<'PY' || die "live /contract schema_version does not match this checkout"
import json, sys
live = json.load(open(sys.argv[1], encoding="utf-8"))
local = json.loads(sys.argv[2])
lv = live.get("schema_version")
lc = local.get("schema_version")
print(f"live_schema={lv} local_schema={lc}")
raise SystemExit(0 if lv == lc and lv is not None else 1)
PY

echo "live-origin ok title=$title schema matches checkout"
