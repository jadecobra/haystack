    if prop == "og:title" and content:
        need["og:title"] = True
    elif prop == "og:image" and content:
        need["og:image"] = content
    elif prop == "og:url" and content:
        need["og:url"] = True
    elif prop == "twitter:card" and content == "summary_large_image":
        need["twitter:card"] = True
