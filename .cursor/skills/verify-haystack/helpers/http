#!/usr/bin/env bash
# Isolated-origin HTTP driver (curl). Never uses ports 3000 or 8000.
#
# Usage:
#   FEATURE=home-search helpers/http home
#   FEATURE=analyze-results helpers/http analyze-api AAPL
#   FEATURE=backend-health helpers/http backend-health
#   FEATURE=backend-analyze helpers/http backend-analyze AAPL
#   VERIFY_FIXTURE=1 FEATURE=backend-analyze helpers/http backend-analyze AAPL
#   FEATURE=backend-analyze helpers/http backend-analyze AAPL --fixture
#   FEATURE=backend-contract helpers/http backend-contract
#   FEATURE=empty-ticker helpers/http empty-ticker
#   FEATURE=metrics-docs helpers/http docs
#   FEATURE=share-preview helpers/http share-preview AAPL
#   LIVE=1 FEATURE=share-preview helpers/http share-preview AAPL
#   ORIGIN=https://longmuch.com FEATURE=share-preview helpers/http share-preview AAPL
#
# backend-analyze defaults to live EDGAR. Fixture only when VERIFY_FIXTURE=1
# or --fixture/--local (runs `uv run longmuch analyze TICKER --local`).
# Curl-local HAYSTACK_PREFER_FIXTURE does not affect the already-running uvicorn.
# The ?fixture= query is ignored. Server-env HAYSTACK_PREFER_FIXTURE still works
# if the backend process was started with it.
#
# Evidence lands in .cursor/skills/verify-haystack/artifacts/<feature>/

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

# share-preview can target production without a local run.env.
# LIVE=1 defaults ORIGIN to https://longmuch.com. Never attach to :3000.
if [[ "${1:-}" == "share-preview" && ( -n "${ORIGIN:-}" || "${LIVE:-0}" == "1" ) ]]; then
  if [[ -n "${ORIGIN:-}" ]]; then
    FRONTEND_ORIGIN="${ORIGIN%/}"
  else
    FRONTEND_ORIGIN="https://longmuch.com"
  fi
  if [[ "$FRONTEND_ORIGIN" == *":3000"* ]]; then
    die "refusing frontend origin $FRONTEND_ORIGIN (port 3000)"
  fi
else
  load_run
  refuse_frontend_origin "$FRONTEND_ORIGIN"
fi

FEATURE="${FEATURE:-adhoc}"
EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
mkdir -p "$EVIDENCE"

save_meta() {
  local name="$1" code="$2" url="$3" body="$4"
  {
    echo "feature=$FEATURE"
    echo "origin_frontend=$FRONTEND_ORIGIN"
    echo "origin_backend=${BACKEND_ORIGIN:-}"
    echo "url=$url"
    echo "http_status=$code"
    echo "title=$(html_title "$body")"
    echo "h1=$(html_h1 "$body")"
    echo "placeholder=$(html_placeholder "$body")"
    echo "button=$(html_button_text "$body")"
    echo "button_disabled=$(button_is_disabled "$body")"
    echo "longmuch_count=$(html_count "$body" 'LongMuch')"
    echo "subtitle_count=$(html_count "$body" 'How much? How long?')"
    echo "analyze_count=$(html_count "$body" 'Analyze')"
    echo "placeholder_count=$(html_count "$body" 'enter stock ticker e.g. AAPL')"
    echo "table_title_count=$(html_count "$body" 'Financial Metrics')"
    echo "hardcoded_200B_count=$(html_count "$body" '$200B')"
    echo "kpi_revenue_count=$(html_count "$body" 'Revenue')"
    echo "create_next_app_count=$(html_count "$body" 'Create Next App')"
    echo "longmuch_title_count=$(html_count "$body" 'LongMuch - How much? How long?')"
  } > "$EVIDENCE/${name}.meta.txt"
}

http_get() {
  local origin="$1"
  local path="$2"
  local name="${3:-get}"
  local url="${origin}${path}"
  local body="$EVIDENCE/${name}.html"
  local code
  code="$(curl -sS -o "$body" -w '%{http_code}' --max-time 20 "$url" || echo "000")"
  echo "$code" > "$EVIDENCE/${name}.status"
  save_meta "$name" "$code" "$url" "$body"
  echo "GET $url -> HTTP $code"
  echo "  title=$(html_title "$body")"
  echo "  h1=$(html_h1 "$body")"
  echo "  saved=$body"
  echo "$code"
}

require_backend() {
  [[ "${BACKEND_OK:-0}" == "1" && -n "${BACKEND_ORIGIN:-}" ]] || die "backend not running (BACKEND_OK=${BACKEND_OK:-0}). Re-launch or skip API features."
  refuse_backend_origin "$BACKEND_ORIGIN"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  home)
    FEATURE="${FEATURE:-home-search}"
    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    code="$(http_get "$FRONTEND_ORIGIN" / home | tail -n 1)"
    [[ "$code" == "200" ]] || die "home GET not 200 (got $code)"
