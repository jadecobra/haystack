    grep -q 'enter stock ticker e.g. AAPL' "$EVIDENCE/home.html" || die "home HTML missing ticker placeholder"
    grep -q 'Analyze' "$EVIDENCE/home.html" || die "home HTML missing Analyze button text"
    grep -q 'How much? How long?' "$EVIDENCE/home.html" || die "home HTML missing document title phrase How much? How long?"
    grep -q 'How metrics are calculated' "$EVIDENCE/home.html" || die "home HTML missing docs link"
    grep -q 'S&amp;P 500 OE-yield screen\|S&P 500 OE-yield screen' "$EVIDENCE/home.html" || die "home HTML missing /screen link"
    grep -q 'JadeCobra LLC' "$EVIDENCE/home.html" || die "home HTML missing JadeCobra LLC copyright"
    echo "home-search ok h1=$(html_h1 "$EVIDENCE/home.html") title=$(html_title "$EVIDENCE/home.html")"
    # Next.js "N Issues" badge is client-only; curl cannot see it. Prefer Playwright gate.
    if [[ "${SKIP_NEXT_ISSUES_CHECK:-0}" != "1" ]]; then
      set +e
      ISSUE_OUT="$(node "$SCRIPT_DIR/browser.cjs" check-issues 2>&1)"
      ISSUE_RC=$?
      set -e
      echo "$ISSUE_OUT"
      if [[ "$ISSUE_RC" -eq 1 ]]; then
        die "home prove failed: visible Next issues badge. A prove that ignores it is invalid."
      elif [[ "$ISSUE_RC" -eq 2 ]]; then
        echo "NEXT_ISSUES_CHECK=hard-flag skipped (Playwright/Chromium missing). A prove that ignores this gate is invalid."
      elif [[ "$ISSUE_RC" -ne 0 ]]; then
        die "home prove Next issues check failed (rc=$ISSUE_RC)"
      fi
    fi
    ;;
  analyze-api)
    FEATURE="${FEATURE:-analyze-results}"
    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    ticker="${1:-AAPL}"
    ticker="$(printf '%s' "$ticker" | tr '[:lower:]' '[:upper:]')"
    path="/api/analyze/${ticker}"
    url="${FRONTEND_ORIGIN}${path}"
