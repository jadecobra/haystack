    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    code="$(http_get "$FRONTEND_ORIGIN" /docs docs | tail -n 1)"
    [[ "$code" == "200" ]] || die "docs GET not 200 (got $code)"
