    grep -q 'JadeCobra LLC' "$EVIDENCE/docs.html" || die "docs HTML missing JadeCobra LLC copyright"
    grep -q 'Owner Earnings / Last Close Price' "$EVIDENCE/docs.html" || die "docs HTML missing OE/close label"
    grep -q 'Owner Earnings / 30 Year Treasury per Share' "$EVIDENCE/docs.html" || die "docs HTML missing treasury label"
