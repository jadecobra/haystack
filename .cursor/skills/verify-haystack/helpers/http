        need["canonical"] = True
missing = [k for k, v in need.items() if not v]
print("share-meta", {k: bool(v) for k, v in need.items()})
if need["og:image"]:
    open(sys.argv[3], "w", encoding="utf-8").write(need["og:image"])
    print("og:image", need["og:image"])
raise SystemExit(1 if missing else 0)
