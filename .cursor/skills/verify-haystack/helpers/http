    grep -q 'Owner Earnings / Last Close Price' "$body" || die "analyze JSON missing Owner Earnings / Last Close Price"
    grep -q '"rows"' "$body" || die "analyze JSON missing rows"
    python3 - "$body" "$ticker" <<'PY' || die "analyze JSON missing company_name"
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
name = data.get("company_name")
print(f"company_name={name!r}")
if sys.argv[2] == "AAPL":
    raise SystemExit(0 if name == "Apple Inc." else 1)
raise SystemExit(0 if "company_name" in data else 1)
PY
    http_get "$FRONTEND_ORIGIN" / home-after-api >/dev/null
    table_count="$(html_count "$EVIDENCE/home-after-api.html" 'Financial Metrics')"
    echo "  homepage_table_after_api_get=$table_count (SSR never includes the table; it is client-state after JSON)"
    echo "$code"
    ;;
  backend-health)
