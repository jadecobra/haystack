    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    code="$(http_get "$FRONTEND_ORIGIN" /screen screen | tail -n 1)"
    [[ "$code" == "200" ]] || die "screen GET not 200 (got $code)"
    grep -q 'S&amp;P 500 owner-earnings yield\|S&P 500 owner-earnings yield' "$EVIDENCE/screen.html" || die "screen HTML missing heading"
    grep -q 'not live, not a growth screen' "$EVIDENCE/screen.html" || die "screen HTML missing caveat"
    api_body="$EVIDENCE/screen-api.json"
    api_code="$(curl -sS -o "$api_body" -w '%{http_code}' --max-time 20 "$FRONTEND_ORIGIN/api/screen/sp500-oe-yield" || echo "000")"
    echo "$api_code" > "$EVIDENCE/screen-api.status"
    [[ "$api_code" == "200" ]] || die "screen API not 200 (got $api_code)"
    grep -q '"oe_yield"' "$api_body" || die "screen JSON missing oe_yield"
    grep -q '"ticker"' "$api_body" || die "screen JSON missing ticker"
    echo "sp500-screen ok http=$code api=$api_code"
    ;;
  empty-ticker)
    FEATURE="${FEATURE:-empty-ticker}"
    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    code="$(http_get "$FRONTEND_ORIGIN" / home | tail -n 1)"
    [[ "$code" == "200" ]] || die "home GET not 200"
    disabled="$(button_is_disabled "$EVIDENCE/home.html")"
    [[ "$disabled" == "yes" ]] || die "Analyze button is not disabled on empty ticker SSR HTML (got $disabled)"
    echo "empty-ticker ok: Analyze disabled=$disabled on empty input"
    ;;
  share-preview)
    FEATURE="${FEATURE:-share-preview}"
    EVIDENCE="$ARTIFACTS_DIR/$FEATURE"
    mkdir -p "$EVIDENCE"
    ticker="${1:-AAPL}"
    ticker="$(printf '%s' "$ticker" | tr '[:lower:]' '[:upper:]')"
    lower="$(printf '%s' "$ticker" | tr '[:upper:]' '[:lower:]')"
    page="$EVIDENCE/page.html"
    page_url="${FRONTEND_ORIGIN}/${ticker}"
    code="$(curl -sS -o "$page" -w '%{http_code}' --max-time 30 "$page_url" || echo "000")"
    echo "$code" > "$EVIDENCE/page.status"
    {
      echo "feature=$FEATURE"
      echo "origin=$FRONTEND_ORIGIN"
      echo "url=$page_url"
      echo "http_status=$code"
      echo "live=${LIVE:-0}"
    } > "$EVIDENCE/page.meta.txt"
    echo "GET $page_url -> HTTP $code"
    [[ "$code" == "200" ]] || die "ticker page not 200 (got $code)"
    python3 - "$page" "$ticker" "$EVIDENCE/og-image.url" <<'PY' || die "ticker HTML missing share meta"
