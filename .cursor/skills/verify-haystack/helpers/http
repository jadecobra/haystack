    {
      echo "feature=$FEATURE"
      echo "url=$url"
      echo "http_status=$code"
      echo "body=$(tr -d '\n' < "$body")"
    } > "$EVIDENCE/backend-contract.meta.txt"
    echo "GET $url -> HTTP $code"
    [[ "$code" == "200" ]] || die "backend /contract not 200"
