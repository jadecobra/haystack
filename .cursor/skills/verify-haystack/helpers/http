    grep -q 'Federal Reserve Economic Data' "$EVIDENCE/docs.html" || die "docs HTML missing FRED spelling"
    grep -q 'Electronic Data Gathering, Analysis, and Retrieval' "$EVIDENCE/docs.html" || die "docs HTML missing EDGAR spelling"
    grep -q 'Generally Accepted Accounting Principles' "$EVIDENCE/docs.html" || die "docs HTML missing US-GAAP spelling"
    grep -q 'NASDAQ Stock Market' "$EVIDENCE/docs.html" || die "docs HTML missing NASDAQ spelling"
