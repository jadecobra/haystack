    grep -q 'Owner Earnings / 30 Year Treasury per Share' "$body" || die "contract JSON missing treasury label"
    grep -q 'Owner Earnings / Last Close Price' "$body" || die "contract JSON missing Owner Earnings / Last Close Price"
    grep -q '"groups"' "$body" || die "contract JSON missing groups"
